# Copy to .env and fill in. The server reads .env from the project folder on start.

# API keys. A server that has never had one runs in simulation: every seat
# gives a scripted answer and nothing is spent. With any, organisations can be
# set to run on that provider's models, and every call is billed to the key.
# Keys can also be added in the interface, under "Models and keys"; a key set
# here is used as it is and never written to disk by the server.
# ANTHROPIC_API_KEY=sk-ant-...      # Claude
# OPENAI_API_KEY=sk-...             # GPT
# GEMINI_API_KEY=...                # Gemini (a Google AI Studio key)
# META_API_KEY=LLM_...              # Muse
# MOONSHOT_API_KEY=...              # Kimi
# DEEPSEEK_API_KEY=...              # DeepSeek
# DASHSCOPE_API_KEY=...             # Qwen (Alibaba Cloud Model Studio)
# ZAI_API_KEY=...                   # GLM (Z.ai; ZHIPUAI_API_KEY is read too)
# TOKENHUB_API_KEY=...              # Hunyuan (Tencent Cloud TokenHub)
# MINIMAX_API_KEY=...               # MiniMax
# ARK_API_KEY=...                   # Doubao and Seed (ByteDance)
# OPENROUTER_API_KEY=sk-or-...      # several hundred models from every maker

# A provider with separate international and mainland-China platforms issues a
# key for one of them. A key set above is used on the international platform
# unless the provider's address is given here. The name is the provider's short
# name (the part before the colon in a model's name) in capitals.
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# TENCENT_BASE_URL=https://tokenhub.tencentcloudmaas.com/v1
# MINIMAX_BASE_URL=https://api.minimax.cn/v1
# BYTEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Claude Code in place of a key. It is connected in the interface, under
# "Models and keys", and needs nothing here unless the command is not on the
# PATH. With extra usage switched on for your account, an organisation pauses
# when the plan's included usage is spent; "allow" lets it carry on, billed.
# CLAUDE_CODE_PATH=/path/to/claude
# CLAUDE_CODE_EXTRA_USAGE=allow

# Simulate whatever keys there are, or have been: mock
# ORG_PROVIDER=mock

# Where the server listens. Keep the host on loopback unless you mean to share
# it: the API has no login, so anyone who can reach the port runs your
# organisations and can add or use your keys.
# PORT=4780
# HOST=127.0.0.1

# With HOST set to something other machines can reach, the server answers
# requests addressed to it by IP address. To reach it by a name as well, list
# the names here. Any other name is refused: it is how a web page would reach
# a server it has no business with.
# ORG_ALLOWED_HOSTS=office-box.lan

# Where organisations are stored (state, activity log, archive, workspace
# files), and the keys added in the interface.
# ORG_DATA_DIR=./data

# Hosted sessions (Claude Managed Agents) are linked from the dashboard to the
# Anthropic Console. The link needs the workspace your API key belongs to:
# leave this unset for the Default workspace, otherwise set the workspace's ID
# (it is in the Console's address bar).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Gmail / Google Workspace. Enable the Gmail API and create a Web application
# OAuth client. Register the exact callback shown under Email & accounts:
# http://127.0.0.1:4780/api/oauth/google/callback (or your localhost hostname).
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# Service-account browser. Uses installed Google Chrome by default.
# ORG_BROWSER_PATH=/path/to/chromium

# Running code in a sandbox, for the roles allowed to under Privileges. It
# needs Docker, and is off by itself when HOST is not loopback. "off" here
# switches it off whatever a role is allowed. The command is the one that runs
# containers, and the last two are what one command in a sandbox may use.
# See docs/code-execution.md.
# ORG_SANDBOX=off
# ORG_SANDBOX_COMMAND=docker
# ORG_SANDBOX_MEMORY_MB=2048
# ORG_SANDBOX_CPUS=2

# Business vault passphrases are entered in the interface and never stored
# here. Unlock again after a server restart. See docs/email-and-accounts.md.
