# Copy to .env and fill in. The server reads .env from the project folder on start.

# With a key set, organisations run on Claude and every call is billed to it.
# With none, the server runs in simulation: every seat gives a scripted answer.
# ANTHROPIC_API_KEY=sk-ant-...

# Force a provider regardless of credentials: claude | mock
# ORG_PROVIDER=mock

# Where the server listens. Keep the host on loopback unless you mean to share
# it: the API has no login, so anyone who can reach the port runs your organisations.
# PORT=4780
# HOST=127.0.0.1

# Where organisations are stored (state, activity log, archive, workspace files).
# ORG_DATA_DIR=./data
