{
  "name": "the-organisation",
  "version": "0.1.0",
  "private": true,
  "description": "Establish a hierarchical organisation of AI agents from a single prompt: a CEO, an executive team with standard operating profiles, and the agents they direct.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PolyLabs-research/the_organisation.git"
  },
  "homepage": "https://github.com/PolyLabs-research/the_organisation#readme",
  "bugs": {
    "url": "https://github.com/PolyLabs-research/the_organisation/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/main.ts",
    "build": "vite build",
    "start": "tsx src/server/main.ts --production",
    "establish": "tsx scripts/establish.ts",
    "example:paperclips": "tsx scripts/only-paperclips.ts",
    "managed:setup": "tsx scripts/managed-setup.ts",
    "claude-code:check": "tsx scripts/claude-code-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "tsx scripts/smoke-business.ts",
    "docs:screenshots": "vitest run --config vitest.screenshots.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "express": "^5.3.0",
    "imapflow": "^2.11.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.68.0",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.3.1",
    "openai": "^7.51.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
